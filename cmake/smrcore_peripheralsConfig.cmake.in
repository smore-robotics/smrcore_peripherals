@PACKAGE_INIT@

# Shared libraries resolve their private dependencies at build time.
# Static consumers still need the private link dependencies exported by CMake.
if(NOT "@BUILD_SHARED_LIBS@")
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
    find_dependency(nlohmann_json)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/smrcore_peripheralsTargets.cmake")
