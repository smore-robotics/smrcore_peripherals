# 单一上传版本真源（仅供 source 使用）
#
# 解析 CI_COMMIT_TAG，导出 wheel 上传路径用的版本变量：
#   SMRCORE_PERIPHERALS_UPLOAD_VERSION  打 tag 时为 x.y.z（去 v）；无 tag 时为 latest

if [ -n "${CI_COMMIT_TAG:-}" ]; then
    _dv_normalized="${CI_COMMIT_TAG#v}"
    if ! printf '%s' "${_dv_normalized}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo "detect_version: CI_COMMIT_TAG 不是 x.y.z / vx.y.z 格式: ${CI_COMMIT_TAG}" >&2
        unset _dv_normalized
        return 1 2>/dev/null || exit 1
    fi
    SMRCORE_PERIPHERALS_UPLOAD_VERSION="${_dv_normalized}"
    unset _dv_normalized
else
    SMRCORE_PERIPHERALS_UPLOAD_VERSION="latest"
fi

export SMRCORE_PERIPHERALS_UPLOAD_VERSION
